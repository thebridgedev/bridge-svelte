#!/bin/sh
# Before-push docs link check (OPS-71). Runs from the shared pre-push in ~/Workflows/githooks once
# this repo opts in:    git config workflows.localPrePush .githooks/pre-push
# (undo:                git config --unset workflows.localPrePush)
#
# Runs only when a pushed commit touches learning/ (or the checker), and checks the commit being
# pushed, not the working tree: learning/ and scripts/ at that commit are exported to a temp dir.
# Dependency-free node, well under a second. Skip once with: SKIP_LINK_CHECK=1 git push
[ -n "${SKIP_LINK_CHECK:-}" ] && { cat >/dev/null; exit 0; }
command -v node >/dev/null 2>&1 || { cat >/dev/null; echo "docs link check: node not found, skipped" >&2; exit 0; }
ZERO=0000000000000000000000000000000000000000
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] || [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    touched=$(git log --format= --name-only "$local_sha" --not --remotes -- learning scripts/check-docs-links.mjs scripts/docs-site-pages.txt)
  else
    touched=$(git diff --name-only "$remote_sha" "$local_sha" -- learning scripts/check-docs-links.mjs scripts/docs-site-pages.txt)
  fi
  [ -n "$touched" ] || continue
  git cat-file -e "$local_sha:scripts/check-docs-links.mjs" 2>/dev/null || continue
  tmp=$(mktemp -d) || continue
  git archive "$local_sha" learning scripts/check-docs-links.mjs scripts/docs-site-pages.txt 2>/dev/null | tar -x -C "$tmp" 2>/dev/null
  out=$(cd "$tmp" && node scripts/check-docs-links.mjs 2>&1)
  rc=$?
  rm -rf "$tmp"
  if [ $rc -eq 1 ]; then
    printf '%s\n' "$out" >&2
    echo "docs link check: push of $local_ref refused, fix the links above (or skip once: SKIP_LINK_CHECK=1 git push)" >&2
    fail=1
  else
    printf '%s\n' "$out" | tail -1 | sed "s|^|docs link check ($local_ref): |" >&2
  fi
done
exit $fail
