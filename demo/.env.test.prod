# Demo app config for E2E tests — production bridge backend.
# Loaded by `vite dev --mode test.prod`, i.e. `bun run test:e2e:prod`.
#
# Tracked in git on purpose: it holds no secrets, and a clean checkout has to be
# able to run the prod suite without anyone hand-writing a file first (TBP-606).
#
# NOTE: No auth/cloud-views URLs set — the plugin resolves production
# endpoints automatically. This mirrors the real user experience.
#
# The app id is NOT set here. `e2e/playwright/global-setup.ts` resolves it from
# the prod test-data API and seeds it into localStorage as `bridge:appId`, which
# `demo/src/routes/+layout.ts` prefers over this variable. Uncomment the line
# below only to pin a specific app id — e.g. when serving this demo by hand,
# outside Playwright.
# VITE_BRIDGE_APP_ID=

VITE_ENVIRONMENT=prod
VITE_BRIDGE_CALLBACK_URL=http://localhost:3008/auth/oauth-callback
VITE_BRIDGE_DEBUG=true
