# Demo app config for E2E tests — stage bridge backend.
# Loaded by `vite dev --mode test.stage`, i.e. `bun run test:e2e:stage`.
#
# Tracked in git on purpose: it holds only public stage endpoints, and a clean
# checkout has to be able to run the stage suite without anyone hand-writing a
# file first (TBP-606).
#
# EVERY key this file cares about must be written here, even when the value is
# empty. Vite's precedence is `.env.[mode]` > `.env.local` > `.env`, so a key
# this file LEAVES OUT falls through to `demo/.env.local` — a developer's
# untracked, slot-local file pointing at localhost. That is how the stage run
# ended up sending hosted-mode login to `http://localhost:3091` with the local
# slot's app id and getting "[GraphQL] App not found" (TBP-607). Silence here is
# not "use the default"; it is "use whatever the developer happens to have".

# Resolved by `e2e/playwright/global-setup.ts` from the stage test-data API and
# seeded into localStorage as `bridge:appId`, which `demo/src/routes/+layout.ts`
# prefers over this variable. Deliberately EMPTY rather than absent, so
# `demo/.env.local`'s local app id cannot become the fallback. To serve this
# demo by hand outside Playwright, put a stage app id here.
VITE_BRIDGE_APP_ID=

# The stage hosted login portal (bridge-cloud-views). Needed for hosted mode —
# without it the SDK default is the PRODUCTION portal and `.env.local` overrides
# that with the local one; both fail against a stage app id.
VITE_BRIDGE_HOSTED_URL=https://auth-stage.thebridge.dev

# Surfaced by the demo's AppShell env pill, which global-setup asserts against
# the Playwright project — that check is what makes a reused Docker demo running
# the wrong `--mode` fail loudly instead of quietly measuring another backend.
VITE_ENVIRONMENT=stage

VITE_BRIDGE_CALLBACK_URL=http://localhost:3008/auth/oauth-callback
VITE_BRIDGE_API_BASE_URL=https://api-stage.thebridge.dev
VITE_BRIDGE_DEBUG=true
