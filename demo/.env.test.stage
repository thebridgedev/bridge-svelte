# Demo app config for E2E tests — stage bridge backend.
# Loaded by `vite dev --mode test.stage`, i.e. `bun run test:e2e:stage`.
#
# Tracked in git on purpose: it holds only public stage endpoints, and a clean
# checkout has to be able to run the stage suite without anyone hand-writing a
# file first (TBP-606).
#
# The app id is NOT set here. `e2e/playwright/global-setup.ts` resolves it from
# the stage test-data API and seeds it into localStorage as `bridge:appId`, which
# `demo/src/routes/+layout.ts` prefers over this variable. Uncomment the line
# below only to pin a specific app id — e.g. when serving this demo by hand,
# outside Playwright.
# VITE_BRIDGE_APP_ID=

VITE_BRIDGE_CALLBACK_URL=http://localhost:3008/auth/oauth-callback
VITE_BRIDGE_API_BASE_URL=https://api-stage.thebridge.dev
VITE_BRIDGE_DEBUG=true
