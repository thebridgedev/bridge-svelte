{
	"name": "bridge-svelte-workspace",
	"private": true,
	"workspaces": [
		"bridge-svelte",
		"demo"
	],
	"scripts": {
		"check:docs-links": "node scripts/check-docs-links.mjs",
		"build": "bun run --filter demo build",
		"build:bridge": "bun run --filter @nebulr-group/bridge-svelte build",
		"dev": "bun run --filter demo dev",
		"package": "bun run --filter @nebulr-group/bridge-svelte package",
		"publish:local": "bun run publish:local:core && bun run publish:local:plugin",
		"publish:local:core": "cd ../auth-core && bun run publish:local",
		"publish:local:plugin": "bun run --filter @nebulr-group/bridge-svelte publish:local",
		"build:docs": "bun learning/scripts/extract-md-from-mdx.ts learning/mdx/ learning/md/",
		"test:e2e": "bash scripts/check-no-networkidle.sh && bunx playwright test",
		"test:networkidle-guard": "bash scripts/check-no-networkidle.sh",
		"test:e2e:report": "bunx playwright show-report test-reports/playwright-report",
		"test:install": "bash scripts/test-install.sh",
		"test:unit": "bun run --filter @nebulr-group/bridge-svelte test:unit",
		"check": "bun run --filter @nebulr-group/bridge-svelte check && bun run --filter demo check"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@types/node": "^25.2.2",
		"mdx-to-md": "^0.5.2"
	},
	"dependencies": {
		"@nebulr-group/bridge-auth-core": "1.0.0-alpha.2"
	},
	"version": "0.1.0-beta.0"
}
